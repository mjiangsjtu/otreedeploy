# One oTree experiment. Instantiated per project: otree@<slug>.service
#
# Exactly one instance is enabled at a time -- "enabled" is what makes a project the live
# one, which is also what brings it back after a reboot.
#
# Installed by bootstrap.sh as /etc/systemd/system/otree@.service

[Unit]
Description=oTree experiment: %i
Documentation=https://otree.readthedocs.io/
After=network-online.target postgresql.service
Wants=network-online.target
# The experiment must follow PostgreSQL in both directions. oTree holds one database
# connection for its whole life (SQLAlchemy StaticPool) and never reconnects, so a
# process that outlives a database restart answers every request with HTTP 500.
#  - Requires= + PartOf=: stopping or restarting PostgreSQL stops or restarts this too.
#  - WantedBy=postgresql.service below: starting PostgreSQL starts the live experiment
#    again. A package upgrade stops and then starts PostgreSQL as two separate steps,
#    and without this the experiment stayed down after the start.
Requires=postgresql.service
PartOf=postgresql.service

[Service]
Type=exec
# Each project runs as its own user (otree_<slug>), set by the drop-in that
# `otree-ctl provision` writes to otree@<slug>.service.d/10-identity.conf. The shared
# `otree` user below is only a fallback for an install that has not been migrated.
User=otree
Group=otree
WorkingDirectory=/srv/otree/%i/current
EnvironmentFile=/srv/otree/%i/env

# `otree prodserver` re-invokes itself as the bare name `otree` to spawn its timeout
# worker, so the venv must be on PATH -- an absolute ExecStart alone is not enough and
# the server exits immediately without this.
Environment=PATH=/srv/otree/%i/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/otree/%i/current/.venv/bin/otree prodserver ${PORT}

# Binding port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=3
# Default KillMode=control-group reaps the timeout worker along with the server.
# A participant's open page keeps a websocket open, and oTree's server waits for those
# before exiting. 30 seconds meant half a minute of downtime on most restarts during
# fieldwork (N3); after 10 the remaining connections are cut, and the pages reconnect.
TimeoutStopSec=10

# This runs experimenter-supplied Python. Keep it away from everything it does not need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/srv/otree/%i

StandardOutput=journal
StandardError=journal
SyslogIdentifier=otree-%i

[Install]
# Only the live project is enabled, so only it is pulled in by either target.
WantedBy=multi-user.target postgresql.service
